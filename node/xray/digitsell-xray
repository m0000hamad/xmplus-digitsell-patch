#!/usr/bin/env bash
#
# digitsell-xray (also: dxray) - day-to-day commands for the Digitsell Xray node.

set -uo pipefail

LIB=/usr/local/lib/digitsell-xray
ETC=/etc/digitsell-xray
REPO_RAW="${DIGITSELL_REPO_RAW:-https://raw.githubusercontent.com/m0000hamad/xmplus-digitsell-patch/main}"
AGENT="python3 $LIB/xray-agent.py"

usage() {
    cat <<'EOF'
digitsell-xray <command>

  status        what runs: nodes, accounts, online, certificates, last report
  menu          interactive management menu (also the default)
  install       guided install / reconfigure
  nodes         list nodes configured on this machine
  add [IDs]     add panel nodes, keeping existing nodes and their settings
  remove [IDs]  remove nodes from this machine (not from the panel)
  log [-n N]    live log of the agent and Xray (Ctrl+C to stop)
  check         ask the panel about every node and print what would run
  doctor        check this server end to end
  restart       restart the agent and Xray
  start | stop  start / stop both
  update        newest Xray, geo files, lego and agent (settings kept)
  config        open agent.json in an editor, then restart
  render        print the Xray config the agent builds
  bbr           turn BBR on
  version       versions
  uninstall     remove the node (see: digitsell-xray uninstall --help)
EOF
}

[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }

has_tty() { [ -t 0 ] || { [ -e /dev/tty ] && (: < /dev/tty) 2>/dev/null; }; }
ask() {
    if [ -t 0 ]; then read -r -p "$1" REPLY; else read -r -p "$1" REPLY < /dev/tty; fi
}
run_installer() (
    tmp=$(mktemp) || exit 1
    trap 'rm -f "$tmp"' EXIT
    curl -fsSL "$REPO_RAW/node/xray/install.sh" -o "$tmp" || exit 1
    DIGITSELL_FROM_REPO=1 bash "$tmp" "$@"
)
node_command() {
    local manager="${DIGITSELL_MANAGER_DIR:-$LIB}/node-manager.py"
    [ -f "$ETC/agent.json" ] && [ -f "$LIB/xray-agent.py" ] || {
        echo "Install first (menu option 1)." >&2; return 1;
    }
    [ -f "$manager" ] || { echo "Run the latest install.sh menu or 'dxray update' first." >&2; return 1; }
    if [ -t 0 ]; then
        python3 "$manager" --config "$ETC/agent.json" "$@"
    elif has_tty; then
        python3 "$manager" --config "$ETC/agent.json" "$@" < /dev/tty
    else
        python3 "$manager" --config "$ETC/agent.json" "$@"
    fi
}
menu() {
    has_tty || { echo "A terminal is required for the menu; use --help for commands." >&2; return 1; }
    while true; do
        cat <<'EOF'

Digitsell Xray / dxray
  1) Install / reconfigure (guided)
  2) Add node(s)
  3) Remove node(s) from this machine
  4) List configured nodes
  5) Status
  6) Recent logs
  7) Live logs (Ctrl+C to return)
  8) Doctor / diagnostics
  9) Check panel settings
 10) Restart agent / sync settings
 11) Start services
 12) Stop services
 13) Update Xray and agent
 14) Edit configuration
 15) Versions
 16) Uninstall
  0) Exit
EOF
        ask "Choice: " || return 0
        case "$REPLY" in
            0|q|exit) return 0 ;;
            1) run_installer --pick ;;
            2) node_command add ;;
            3) node_command remove ;;
            4) node_command list ;;
            5) bash "$0" status ;;
            6) bash "$0" log -n 100 ;;
            7) (trap 'exit 0' INT; journalctl -u digitsell-xray-agent -u digitsell-xray -f -n 50) ;;
            8) bash "$0" doctor ;;
            9) bash "$0" check ;;
            10) bash "$0" restart ;;
            11) bash "$0" start ;;
            12) ask "Stop all configured nodes? [y/N]: " && [[ "$REPLY" =~ ^[yY]([eE][sS])?$ ]] && bash "$0" stop ;;
            13) run_installer --update ;;
            14) bash "$0" config ;;
            15) bash "$0" version ;;
            16)
                echo "1) Keep configuration  2) Delete configuration  3) Restore XMPlus (keep configuration)"
                ask "Uninstall mode (Enter to cancel): " || continue
                local uninstall_args=()
                case "$REPLY" in
                    1) uninstall_args=(--keep-config) ;;
                    2) uninstall_args=() ;;
                    3) uninstall_args=(--keep-config --restore-xmplus) ;;
                    *) continue ;;
                esac
                ask "Uninstall Xray from this machine? Type YES: " || continue
                if [ "$REPLY" = YES ]; then
                    bash "$LIB/uninstall.sh" "${uninstall_args[@]}" && return 0
                fi ;;
            *) echo "Choose a number from the menu." ;;
        esac
    done
}

case "${1:-menu}" in
    menu|--menu) menu ;;
    install) shift; run_installer --pick "$@" ;;
    nodes|list) node_command list ;;
    add|add-node) shift; node_command add "$@" ;;
    remove|remove-node) shift; node_command remove "$@" ;;
    status)
        systemctl --no-pager --lines=0 status digitsell-xray digitsell-xray-agent 2>/dev/null | grep -E "●|Active:" || true
        echo
        $AGENT status ;;
    log|logs)
        shift
        if [ "${1:-}" = "-n" ]; then
            journalctl --no-pager -u digitsell-xray-agent -u digitsell-xray -n "${2:-100}"
        else
            journalctl -u digitsell-xray-agent -u digitsell-xray -f -n 50
        fi ;;
    check)   $AGENT check ;;
    doctor)  $AGENT doctor ;;
    render)  $AGENT render ;;
    restart) systemctl restart digitsell-xray-agent && echo "restarted (the agent restarts Xray only when its settings changed)" ;;
    start)   systemctl start digitsell-xray digitsell-xray-agent ;;
    stop)    systemctl stop digitsell-xray-agent digitsell-xray ;;
    update)
        shift
        run_installer --update "$@" ;;
    config)
        "${EDITOR:-nano}" "$ETC/agent.json" || vi "$ETC/agent.json"
        python3 -c "import json; json.load(open('$ETC/agent.json'))" \
            && systemctl restart digitsell-xray-agent && echo "saved and restarted" \
            || echo "agent.json is not valid JSON - not restarted" >&2 ;;
    bbr)
        modprobe tcp_bbr 2>/dev/null || true
        printf 'net.core.default_qdisc = fq\nnet.ipv4.tcp_congestion_control = bbr\n' > /etc/sysctl.d/98-digitsell-bbr.conf
        sysctl --system >/dev/null 2>&1
        echo "congestion control: $(cat /proc/sys/net/ipv4/tcp_congestion_control)" ;;
    version)
        echo "agent $($AGENT version)"
        "$LIB/xray" version | head -1
        "$LIB/lego" --version 2>/dev/null || true ;;
    uninstall)
        shift
        bash "$LIB/uninstall.sh" "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
