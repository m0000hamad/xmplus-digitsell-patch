#!/bin/sh
#
# NAT and firewall rules for the Digitsell OpenVPN node (installed by
# install.sh as /usr/local/sbin/digitsell-ovpn-nat, settings in
# /etc/digitsell-ovpn/nat.conf).
#
#   start     NAT for each OpenVPN instance's subnet, the firewall openings,
#             and - with ALL_PORTS=1 - every port of each protocol redirected
#             to that protocol's OpenVPN, so the ports customers use are
#             chosen in the panel
#   refresh   rebuild a redirect when the set of ports to leave alone changed
#             (run every minute by digitsell-ovpn-nat-refresh.timer)
#   stop      remove everything this script added
#   excluded [udp|tcp]
#             print the ports left alone, one per line
#
# One OpenVPN instance per protocol: PROTOS="udp tcp" with SUBNETS listed in
# the same order, all listening on PORT. Left alone (never redirected): ports
# another program on this server listens on for that protocol (SSH, a web
# server, Xray...), for TCP the SSH ports from sshd's configuration, 22, and
# EXCLUDE from nat.conf. Only new connections arriving on the public interface
# for one of this server's own addresses are redirected; replies to this
# server's own outgoing traffic are not touched.

CONF=/etc/digitsell-ovpn/nat.conf
STATE=/run/digitsell-ovpn-nat.excluded

[ -r "$CONF" ] || { echo "digitsell-ovpn-nat: $CONF missing" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CONF"
# nat.conf from 1.13.x had one PROTO and one SUBNET
PROTOS="${PROTOS:-$PROTO}"
SUBNETS="${SUBNETS:-$SUBNET}"
: "${PROTOS:?}" "${SUBNETS:?}" "${PORT:?}"
ALL_PORTS="${ALL_PORTS:-1}"
EXCLUDE="${EXCLUDE:-}"

IF=$(ip -4 route show default | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')

rule() { t="$1"; shift; iptables -t "$t" -C "$@" 2>/dev/null || iptables -t "$t" -I "$@"; }
undo() { t="$1"; shift; while iptables -t "$t" -D "$@" 2>/dev/null; do :; done; }

chain() { echo "DIGITSELL_OVPN_$(echo "$1" | tr 'a-z' 'A-Z')"; }

# ports this server's own programs listen on for protocol $1, except OpenVPN
listening() {
    if [ "$1" = "tcp" ]; then flags=-ltnpH; else flags=-lunpH; fi
    ss $flags 2>/dev/null | grep -v '"openvpn"' | awk '{print $4}' | sed 's/.*://'
}

sshd_ports() {
    { sshd -T 2>/dev/null | awk '$1 == "port" {print $2}'
      awk 'tolower($1) == "port" {print $2}' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null; } | sort -u
}

excluded() {
    { echo 22
      [ "$1" = "tcp" ] && sshd_ports
      listening "$1"
      for p in $EXCLUDE; do echo "$p"; done
    } | tr ', ' '\n\n' | grep -E '^[0-9]+$' | awk '$1 >= 1 && $1 <= 65535 && $1 != '"$PORT"'' | sort -n -u
}

redirect_off() {  # $1 protocol, $2 chain
    undo nat PREROUTING -i "$IF" -p "$1" -m addrtype --dst-type LOCAL -j "$2"
    iptables -t nat -F "$2" 2>/dev/null
    iptables -t nat -X "$2" 2>/dev/null
}

redirect_on() {  # $1 protocol
    c=$(chain "$1")
    list=$(excluded "$1")
    iptables -t nat -N "$c" 2>/dev/null || iptables -t nat -F "$c"
    for p in $list; do
        iptables -t nat -A "$c" -p "$1" --dport "$p" -j RETURN
    done
    iptables -t nat -A "$c" -p "$1" -j REDIRECT --to-ports "$PORT"
    rule nat PREROUTING -i "$IF" -p "$1" -m addrtype --dst-type LOCAL -j "$c"
    echo "$list" > "$STATE.$1"
}

# the 1.13.x single-protocol chain, replaced by one chain per protocol
legacy_off() {
    for p in udp tcp; do redirect_off "$p" DIGITSELL_OVPN; done
    rm -f "$STATE"
}

base() {
    act=$1
    for s in $SUBNETS; do
        $act nat POSTROUTING -s "$s" -o "$IF" -j MASQUERADE
        $act filter FORWARD -s "$s" -j ACCEPT
        $act filter FORWARD -d "$s" -m state --state RELATED,ESTABLISHED -j ACCEPT
    done
    for p in $PROTOS; do
        $act filter INPUT -p "$p" --dport "$PORT" -j ACCEPT
    done
}

case "$1" in
    start)
        legacy_off
        base rule
        for p in udp tcp; do
            if [ "$ALL_PORTS" = "1" ] && echo " $PROTOS " | grep -q " $p "; then
                redirect_on "$p"
            else
                redirect_off "$p" "$(chain "$p")"
                rm -f "$STATE.$p"
            fi
        done
        ;;
    refresh)
        [ "$ALL_PORTS" = "1" ] || exit 0
        for p in $PROTOS; do
            c=$(chain "$p")
            # rebuild only when the list changed; the rules themselves are cheap
            if [ "$(excluded "$p")" != "$(cat "$STATE.$p" 2>/dev/null)" ] \
                    || ! iptables -t nat -C PREROUTING -i "$IF" -p "$p" -m addrtype --dst-type LOCAL -j "$c" 2>/dev/null; then
                redirect_on "$p"
            fi
        done
        ;;
    stop)
        legacy_off
        for p in udp tcp; do
            redirect_off "$p" "$(chain "$p")"
            rm -f "$STATE.$p"
        done
        base undo
        ;;
    excluded)
        excluded "${2:-$(echo $PROTOS | awk '{print $1}')}"
        ;;
    *)
        echo "usage: $0 start|refresh|stop|excluded [udp|tcp]" >&2
        exit 1
        ;;
esac
